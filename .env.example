# .env.example
# ZETHICA RAG Chatbot — Configuration Template
# 
# Copy this file to .env.local and fill in your actual credentials.
# NEVER commit .env.local to Git.
#
# For Vercel deployment, add these variables to your project settings
# (Settings > Environment Variables) as encrypted secrets.

# ============================================================================
# DATABASE CONNECTION
# ============================================================================
# Choose ONE of these options:

# Option A: Direct PostgreSQL connection string (Vercel Postgres, self-hosted, etc.)
# Format: postgres://user:password@host:port/database?sslmode=require
POSTGRES_URL=postgres://user:password@localhost:5432/zethica?sslmode=require

# Option B: Supabase PostgreSQL (alternative to POSTGRES_URL)
# If using Supabase, set both SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY
# Leave POSTGRES_URL empty or unset.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================================
# OPENROUTER API (for chat endpoint - Primary Provider)
# ============================================================================
# Get your API key from https://openrouter.io/ (free tier available)
# Never expose this in browser-accessible code.
# All OpenRouter calls happen server-side in Vercel functions.

OPENROUTER_API_KEY=sk-or-v1-...

# Model identifier. See https://openrouter.io/docs/models for available free models.
# 
# Currently available free models (as of Oct 2026):
#   - openrouter/auto (auto-selects best available free model)
#   - meta-llama/llama-2-7b (fast, good for Q&A)
#   - meta-llama/llama-3-8b (higher quality, may have usage limits)
#   - mistralai/mistral-7b (fast, efficient)
#
# Check https://openrouter.io/docs/models to see current free-tier options
# and any rate limits that apply.
#
# Recommended: Start with "openrouter/auto" for reliability.
OPENROUTER_MODEL=openrouter/auto

# ============================================================================
# GEMINI API (for chat endpoint - Fallback Provider)
# ============================================================================
# Optional: Set these to enable automatic fallback to Google Gemini
# when OpenRouter is rate-limited or unavailable.
#
# Get your API key from https://aistudio.google.com/app/apikey
# This is the free tier API from Google AI Studio.
#
# If Gemini variables are not set, fallback is disabled and OpenRouter
# errors will be returned directly to the user.
#
# Model options (as of Oct 2026):
#   - gemini-1.5-flash (fast, free tier, recommended)
#   - gemini-1.5-pro (higher quality, may have rate limits)
#   - gemini-2.0-flash (latest, if available)
#
# See https://ai.google.dev/models for current available models.

GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-1.5-flash

# ============================================================================
# NODE ENVIRONMENT (optional)
# ============================================================================
# Set to 'development' for local testing, 'production' for Vercel
NODE_ENV=development

# ============================================================================
# NOTES
# ============================================================================
# 
# Local Development:
#   1. Copy this file to .env.local
#   2. Fill in POSTGRES_URL (or SUPABASE credentials)
#   3. Fill in OPENROUTER_API_KEY and OPENROUTER_MODEL
#   4. Optionally fill in GEMINI_API_KEY and GEMINI_MODEL for fallback testing
#   5. Run: npm run ingest
#   6. Test with: curl -X POST http://localhost:3000/api/chat ...
#
# Vercel Deployment:
#   1. In Vercel project settings > Environment Variables
#   2. Add required variables: POSTGRES_URL, OPENROUTER_API_KEY, OPENROUTER_MODEL
#   3. Add optional fallback variables: GEMINI_API_KEY, GEMINI_MODEL
#   4. Set Environment to Production (or all environments)
#   5. Redeploy your project
#
# Provider Fallback Behavior:
#   - OpenRouter is the primary provider (always tried first)
#   - Gemini is the fallback provider (optional)
#   - If OpenRouter returns 429 (rate limit), 503 (unavailable), or times out:
#     * Fallback to Gemini IF GEMINI_API_KEY is configured
#     * Return error to user IF GEMINI_API_KEY is not configured
#   - If OpenRouter auth fails (401) or request is invalid (400):
#     * Do NOT fallback (these are not transient errors)
#   - Both providers use the same RAG context and system prompt
#   - Frontend does not know which provider handled the request
#
# Security:
#   - POSTGRES_URL and SUPABASE_SERVICE_ROLE_KEY contain credentials.
#     Keep these private. Use .env.local (added to .gitignore).
#   - OPENROUTER_API_KEY and GEMINI_API_KEY contain credentials.
#     Keep these private. Use .env.local for local dev, Vercel secrets for production.
#   - Never log or expose these values in frontend code or error messages.
#   - Use serverless functions only; API keys are server-side only.
#   - Provider information (_provider field) is for internal logging only.
#     It is not sent to the frontend interface.
