# .env.example
# ZETHICA RAG Chatbot — Configuration Template
# 
# Copy this file to .env.local and fill in your actual credentials.
# NEVER commit .env.local to Git.
#
# For Vercel deployment, add these variables to your project settings
# (Settings > Environment Variables) as encrypted secrets.

# ============================================================================
# DATABASE CONNECTION
# ============================================================================
# Choose ONE of these options:

# Option A: Direct PostgreSQL connection string (Vercel Postgres, self-hosted, etc.)
# Format: postgres://user:password@host:port/database?sslmode=require
POSTGRES_URL=postgres://user:password@localhost:5432/zethica?sslmode=require

# Option B: Supabase PostgreSQL (alternative to POSTGRES_URL)
# If using Supabase, set both SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY
# Leave POSTGRES_URL empty or unset.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================================
# OPENROUTER API (for chat endpoint - Phase A, Step 2)
# ============================================================================
# Get your API key from https://openrouter.io/ (free tier available)
# Never expose this in browser-accessible code.
# All OpenRouter calls happen server-side in Vercel functions.

OPENROUTER_API_KEY=sk-or-v1-...

# Model identifier. See https://openrouter.io/docs/models for available free models.
# 
# Currently available free models (as of Oct 2026):
#   - openrouter/auto (auto-selects best available free model)
#   - meta-llama/llama-2-7b (fast, good for Q&A)
#   - meta-llama/llama-3-8b (higher quality, may have usage limits)
#   - mistralai/mistral-7b (fast, efficient)
#
# Check https://openrouter.io/docs/models to see current free-tier options
# and any rate limits that apply.
#
# Recommended: Start with "openrouter/auto" for reliability.
OPENROUTER_MODEL=openrouter/auto

# ============================================================================
# NODE ENVIRONMENT (optional)
# ============================================================================
# Set to 'development' for local testing, 'production' for Vercel
NODE_ENV=development

# ============================================================================
# NOTES
# ============================================================================
# 
# Local Development:
#   1. Copy this file to .env.local
#   2. Fill in POSTGRES_URL (or SUPABASE credentials)
#   3. Fill in OPENROUTER_API_KEY and OPENROUTER_MODEL
#   4. Run: npm run ingest
#   5. Test with: curl -X POST http://localhost:3000/api/chat ...
#
# Vercel Deployment:
#   1. In Vercel project settings > Environment Variables
#   2. Add each variable (POSTGRES_URL, OPENROUTER_API_KEY, OPENROUTER_MODEL)
#   3. Set Environment to Production (or all environments)
#   4. Redeploy your project
#
# Security:
#   - POSTGRES_URL and SUPABASE_SERVICE_ROLE_KEY contain credentials.
#     Keep these private. Use .env.local (added to .gitignore).
#   - Never log or expose these values in frontend code or error messages.
#   - Use serverless functions only; API keys are server-side only.
